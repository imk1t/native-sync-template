{
  "operations": {
    "/search/repositories": {
      "parameters": [
        "q",
        "sort",
        "order",
        "page",
        "per_page"
      ],
      "response": "SearchResult"
    },
    "/repos/{owner}/{repo}": {
      "parameters": [
        "owner",
        "repo"
      ],
      "response": "Repository"
    },
    "/repos/{owner}/{repo}/issues": {
      "parameters": [
        "owner",
        "repo",
        "state",
        "page",
        "per_page"
      ],
      "response": "Issue",
      "array": true
    },
    "/repos/{owner}/{repo}/issues/{issue_number}": {
      "parameters": [
        "owner",
        "repo",
        "issue_number"
      ],
      "response": "Issue"
    }
  },
  "schemas": {
    "RepoSummary": {
      "source": "#/components/schemas/repo-search-result-item",
      "fields": [
        "id",
        "name",
        "full_name",
        "description",
        "owner",
        "language",
        "stargazers_count",
        "forks_count",
        "topics",
        "html_url"
      ],
      "references": {
        "owner": "Owner"
      }
    },
    "Repository": {
      "source": "#/components/schemas/full-repository",
      "fields": [
        "id",
        "name",
        "full_name",
        "description",
        "owner",
        "language",
        "stargazers_count",
        "forks_count",
        "topics",
        "html_url"
      ],
      "references": {
        "owner": "Owner"
      }
    },
    "Owner": {
      "source": "#/components/schemas/simple-user",
      "fields": [
        "login",
        "avatar_url"
      ],
      "references": {}
    },
    "Issue": {
      "source": "#/components/schemas/issue",
      "fields": [
        "id",
        "number",
        "title",
        "state",
        "body",
        "user",
        "updated_at",
        "pull_request"
      ],
      "references": {
        "user": "Owner",
        "pull_request": "PullRequest"
      }
    },
    "PullRequest": {
      "source": "#/components/schemas/issue/properties/pull_request",
      "fields": [
        "url"
      ],
      "references": {}
    },
    "SearchResult": {
      "source": "#/paths/~1search~1repositories/get/responses/200/content/application~1json/schema",
      "fields": [
        "total_count",
        "incomplete_results",
        "items"
      ],
      "references": {
        "items": "RepoSummary"
      }
    }
  }
}
