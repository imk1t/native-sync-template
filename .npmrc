# パッケージマネージャ（Bun / npm）の設定。依存はサプライチェーン攻撃の入口になるため、既定より厳しくする。
# Bun が読まない設定（公開からの経過日数）は bunfig.toml の [install] に書く。

# 取得元を公式レジストリに固定する（.npmrc やコマンドで別のレジストリに向けられないようにする）
registry=https://registry.npmjs.org/
# TLS の証明書検証を必ず行う
strict-ssl=true
# 依存パッケージの postinstall などのライフサイクルスクリプトを実行しない
ignore-scripts=true
# package.json にバージョン範囲（^1.2.3）ではなく固定のバージョンを書く
save-exact=true
# 公開から 7 日未満のバージョンは入れない（npm 用。Bun は bunfig.toml の minimumReleaseAge）
min-release-age=7
# engines の条件に合わないパッケージは入れない（npm 用）
engine-strict=true
