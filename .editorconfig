root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# 既定の ktlint_official は折り返しなどが厳しいため、Android 公式のコードスタイルに合わせる
ktlint_code_style = android_studio
# Compose の @Composable 関数は大文字で始まるため、関数名の規則から除外する
ktlint_function_naming_ignore_when_annotated_with = Composable
